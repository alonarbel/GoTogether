# Supabase (public — safe in the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Daily Promoter agent (scripts/daily-agent.mjs) — SERVER ONLY, never expose
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Public base URL of the deployed app (no trailing slash), e.g. https://gotogether.vercel.app
APP_URL=

# Email (Resend) — shared with the QA agent
RESEND_API_KEY=
QA_EMAIL=
# Agent email sender. Leave unset to use Resend's sandbox (delivers only to your
# own verified address). After verifying a domain in Resend, set e.g.
# MAIL_FROM=GoTogether <hello@yourdomain>
MAIL_FROM=
# Extra demo recipients beyond QA_EMAIL (comma-separated)
EXTRA_RECIPIENTS=

# QA Playwright auth (optional)
QA_TEST_EMAIL=
QA_TEST_PASSWORD=
