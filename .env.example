# Supabase (public — safe in the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Daily Promoter agent (scripts/daily-agent.mjs) — SERVER ONLY, never expose
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Public base URL of the deployed app (no trailing slash), e.g. https://gotogether.vercel.app
APP_URL=

# Resend — used by the QA agent (scripts/qa-check.mjs)
RESEND_API_KEY=
QA_EMAIL=
# Daily Promoter agent sends through Gmail SMTP — delivers to anyone, no domain.
# GMAIL_USER defaults to QA_EMAIL. GMAIL_APP_PASSWORD is a 16-char Google App
# Password (myaccount.google.com → Security → App passwords; needs 2-Step on).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Extra demo recipients beyond QA_EMAIL (comma-separated)
EXTRA_RECIPIENTS=

# QA Playwright auth (optional)
QA_TEST_EMAIL=
QA_TEST_PASSWORD=
